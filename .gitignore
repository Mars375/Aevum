node_modules/
dist/
.env
.env.local
*.log
.superpowers/

# Real battle replays are build output, not source. The reference battle is
# committed explicitly under replays/reference/ with `git add -f`.
replays/*.json
!replays/reference/
# The catalogue is derived from whatever replays a deployment happens to hold,
# so it is generated at deploy time rather than committed.
replays/index.json

# Les mondes sont des sorties, pas des sources. Un monde vit sur la machine
# qui le fait vivre.
worlds/

# Le catalogue des mondes est derive de ce qu une machine a fait vivre.
worlds/index.json
worlds/status.json
