# Copy to .env and fill in. .env is gitignored and must never be committed.

# Only credential the project needs. Every general's decision goes through
# OpenRouter; no model ever runs locally.
OPENROUTER_API_KEY=sk-or-v1-...

# Hard ceiling from the launch GATE: 0 EUR. The orchestrator refuses any model
# whose id does not end in ":free" while this is 1. Set to 0 only after a new
# human decision raising the budget.
ABS_FREE_MODELS_ONLY=1

# Per-request ceiling. Observed latency across free models spans 3.7s to 213s,
# so an unbounded request can freeze a whole battle.
ABS_REQUEST_TIMEOUT_MS=60000

# Must cover reasoning tokens, which are billed against the completion budget
# before the model emits its first brace. 800 truncates; 3000 clears a turn-1
# prompt but still truncated mid-battle in the reference run.
ABS_MAX_TOKENS=6000
