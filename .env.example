# Copy to .env and fill in. .env is gitignored and must never be committed.

# At least one provider key is required. Prompts only ever carry public
# battlefield state, and a key only ever travels in the Authorization header.

# OpenRouter — 16 ":free" models, 9 of them measured reliable.
OPENROUTER_API_KEY=sk-or-v1-...

# Groq — optional but worth it. 10-40x lower latency (0.4-4.9s against
# 4.5-60s), and its rate limit is independent of OpenRouter's, so a mixed
# roster survives one provider throttling. Models are referenced with a
# "groq:" prefix, e.g. groq:openai/gpt-oss-120b.
GROQ_API_KEY=gsk_...

# Hard ceiling from the launch GATE: 0 EUR.
# On OpenRouter this is enforced per model (":free" suffix required).
# On Groq it CANNOT be enforced in code: the free tier is a property of the
# account, not of the model. An account with no payment method is rate-limited
# rather than billed, so that is where the guarantee actually comes from.
ABS_FREE_MODELS_ONLY=1

# Per-request ceiling. Without it, one slow squad freezes a whole battle.
ABS_REQUEST_TIMEOUT_MS=60000

# Must cover reasoning tokens, which are billed against the completion budget
# before the model emits its first brace. 800 truncates; 3000 clears a turn-1
# prompt but still truncated mid-battle in the first reference run.
ABS_MAX_TOKENS=6000
