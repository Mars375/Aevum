{
  "name": "aevum",
  "version": "0.3.1",
  "private": true,
  "description": "Aevum — Chronique des mondes. Four language models govern persistent civilisations in a deterministic world.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run player:build && npm run spectator:server",
    "spectator:probe": "tsx scripts/spectator-probe.ts",
    "spectator:server": "tsx scripts/spectator-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.player.json",
    "civilization:probe": "tsx scripts/civilization-probe.ts",
    "battle": "tsx packages/cli/src/main.ts",
    "probe": "tsx scripts/probe-providers.ts",
    "player:dev": "npm run dev --workspace @abs/player",
    "player:build": "npm run build --workspace @abs/player",
    "qa:browser": "tsx scripts/browser-qa.ts",
    "qa:observatory": "tsx scripts/observatory-layout.ts",
    "bench:models": "tsx scripts/model-bench.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "tournament": "tsx scripts/tournament.ts",
    "index-replays": "tsx scripts/index-replays.ts",
    "balance": "tsx scripts/balance.ts",
    "live": "tsx scripts/live.ts",
    "world:probe": "tsx scripts/world-probe.ts",
    "index-worlds": "tsx scripts/index-worlds.ts",
    "era-report": "tsx scripts/era-report.ts",
    "eras": "tsx scripts/eras.ts",
    "preflight": "tsx scripts/preflight.ts",
    "build-reports": "tsx scripts/build-reports.ts",
    "rank-eras": "tsx scripts/rank-eras.ts",
    "board-fairness": "tsx scripts/board-fairness.ts",
    "narrate": "tsx scripts/narrate.ts",
    "learning-curve": "tsx scripts/learning-curve.ts",
    "season-report": "tsx scripts/season-report.ts",
    "verify-season-1": "tsx scripts/verify-season-1.ts",
    "launch": "node scripts/launch.mjs",
    "package": "tsx scripts/package-app.ts",
    "agreements:probe": "tsx scripts/agreements-probe.ts",
    "agreements:remote": "tsx scripts/v10-remote-probe.ts",
    "remote:campaign": "tsx scripts/remote-campaign-probe.ts",
    "civilization:seeds": "tsx scripts/infrastructure-seeds-probe.ts",
    "publish:campaigns": "tsx scripts/publish-campaigns.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
